local function getCodeBox()
    local pg=LP:FindFirstChildOfClass("PlayerGui"); if not pg then return nil end
    local g=pg:FindFirstChild("Codes"); if not g then return nil end
    local r=g:FindFirstChild("Codes") or g
    local rd=r:FindFirstChild("CodeRedeem")
    local b=rd and rd:FindFirstChild("TextBox")
    if b and b:IsA("TextBox") then return b end
    for _,i in ipairs(g:GetDescendants()) do if i:IsA("TextBox") then return i end end
end

local function getSubmitButton()
    local pg=LP:FindFirstChildOfClass("PlayerGui"); if not pg then return nil end
    local g=pg:FindFirstChild("Codes"); if not g then return nil end
    local r=g:FindFirstChild("Codes") or g
    local rd=r:FindFirstChild("CodeRedeem") or r
    for _,d in ipairs(rd:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") then
            local n=d.Name:lower()
            local txt=""
            pcall(function() txt=d.Text:lower() end)
            if n:find("submit") or txt:find("submit")
               or n:find("redeem") or txt:find("redeem")
               or n:find("claim") or txt:find("claim")
               or n:find("confirm") or txt:find("confirm")
               or n:find("enter") or txt:find("enter") then
                return d
            end
        end
    end
    return nil
end

local function fireSig(signal,...)
    if typeof(firesignal)~="function" then return false end
    return pcall(firesignal, signal, ...)
end

local function fireConns(signal,...)
    if typeof(getconns)~="function" then return false end
    local ok,conns=pcall(getconns,signal)
    if not ok or type(conns)~="table" then return false end
    local args=table.pack(...)
    for _,c in ipairs(conns) do
        pcall(function()
            if c.Enabled~=false then
                if args.n>0 then c:Fire(table.unpack(args,1,args.n))
                else c:Fire(true) end
            end
        end)
    end
    return true
end

local function submitOnce(ans)
    local box=getCodeBox(); if not box then return false end
    pcall(function() box:CaptureFocus() end)
    task.wait(0.10)
    box.Text=""
    task.wait(0.08)
    box.Text=ans
    task.wait(0.15)
    if box.Text ~= ans then box.Text=ans; task.wait(0.10) end
    fireSig(box.FocusLost, true, Enum.UserInputType.Keyboard)
    fireConns(box.FocusLost, true)
    task.wait(0.10)
    fireSig(box.EnterPressed, Enum.UserInputType.Keyboard)
    fireConns(box.EnterPressed)
    task.wait(0.10)
    local btn=getSubmitButton()
    if btn then
        fireSig(btn.MouseButton1Click)
        fireSig(btn.MouseButton1Down)
        fireSig(btn.MouseButton1Up)
        fireSig(btn.Activated)
        fireConns(btn.MouseButton1Click)
        fireConns(btn.Activated)
    end
    task.wait(0.10)
    pcall(function() box:ReleaseFocus(false) end)
    return true
end

local function submit(ans)
    ans=tostring(ans or ""):upper():gsub("%s+","")
    if ans=="" then return false end
    local ok=pcall(submitOnce, ans)
    return ok
end

