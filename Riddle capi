            out = out:gsub("%s"..f:gsub("%%","%%%%").."%s"," ")
        end
        out = out:gsub("%s+my%s+"," "):gsub("^%s*my%s+"," ")
        out = out:gsub("%s+sammys?%s+"," "):gsub("^%s*sammys?%s+"," ")
        out = out:gsub("%s+the%s+"," "):gsub("%s+of%s+"," "):gsub("%s+for%s+"," ")
        out = out:gsub("%s+a%s+"," "):gsub("%s+an%s+"," "):gsub("%s+in%s+"," ")
        out = out:gsub("%s+i%s+"," "):gsub("%s+is%s+"," "):gsub("%s+was%s+"," ")
        out = out:gsub("%s+"," ")
        return trim(out)
    end

    local function toDigits(s)
        local conv = s
        for word,n in pairs(NUMWORDS) do
            conv = conv:gsub("%f[%a]"..word.."%f[%A]", ordinal(n))
        end
        for word,n in pairs(CARDINALS) do
            conv = conv:gsub("%f[%a]"..word.."%f[%A]", tostring(n))
        end
        return conv
    end

    local QWORDS = {who=true,what=true,which=true,when=true,where=true,how=true,why=true,
                    name=true,tell=true,say=true,type=true,guess=true,answer=true,spell=true,write=true}
    local CATEGORY_WORDS = {mutation=true,machine=true,trait=true,brainrot=true,rarity=true,
                            color=true,number=true,thing=true,one=true,word=true,day=true,
                            year=true,month=true,update=true}
    local STOPWORDS = {you=true,your=true,yours=true,me=true,we=true,us=true,it=true,its=true,
                       be=true,been=true,this=true,that=true,["do"]=true,does=true,did=true,["then"]=true}

    local function words(s)
        local list={}
        for w in s:gmatch("%S+") do list[#list+1]=w end
        return list
    end

    local function dropLead(s)
        local list = words(s)
        if #list<2 or not QWORDS[list[1]] then return nil end
        table.remove(list,1)
        if #list>1 and CATEGORY_WORDS[list[1]] then table.remove(list,1) end
        return table.concat(list," ")
    end

    local function dropStopwords(s)
        local out={}
        for _,w in ipairs(words(s)) do
            if not STOPWORDS[w] then out[#out+1]=w end
        end
        return table.concat(out," ")
    end

    local function localAnswer(text)
        if not text or text=="" then return nil end
        local raw=basicClean(text)
        local aliased=applyAliases(raw)
        local core=stripFillers(aliased)
        local noStop=dropStopwords(core)
        local candidates={raw,aliased,core,noStop}
        local lead=dropLead(core)
        if lead then candidates[#candidates+1]=lead end
        local leadNoStop=dropLead(noStop)
        if leadNoStop then candidates[#candidates+1]=leadNoStop end
        local base=#candidates
        for i=1,base do
            local conv=toDigits(candidates[i])
            if conv~=candidates[i] then candidates[#candidates+1]=conv end
        end
        candidates[#candidates+1]=(core:gsub("%d+",""):gsub("%s+"," "))
        local digitForm=toDigits(noStop)
        local kind,num=digitForm:match("^(.-)%s+(%d+)$")
        if kind and num then candidates[#candidates+1]=ordinal(tonumber(num)).." "..trim(kind) end
        local num2,kind2=digitForm:match("^(%d+)%s+(.-)$")
        if num2 and kind2 then candidates[#candidates+1]=ordinal(tonumber(num2)).." "..trim(kind2) end
        for _,key in ipairs(candidates) do
            key=trim(key)
            if key~="" and SAB_DB[key] then return SAB_DB[key] end
        end
        return nil
    end

    local PROTECTED = {
        ["black and white"]="\1blackwhite\1",["yin and yang"]="\1yinyang\1",
        ["salt and pepper"]="\1saltpepper\1",
    }
    local UNPROTECT={}
    for p,t in pairs(PROTECTED) do UNPROTECT[t]=p end

    local function splitQuestions(text)
        local s=" "..tostring(text or ""):lower().." "
        for p,t in pairs(PROTECTED) do s=s:gsub(p,t) end
        s=s:gsub("%s*[%?%;]%s*"," and ")
        s=s:gsub("%s*,%s*"," and ")
        s=s:gsub("%s*&%s*"," and ")
        s=s:gsub("%s*%+%s*"," and ")
        s=" "..basicClean(s).." "
        s=s:gsub("%s+add%s+"," and "):gsub("%s+plus%s+"," and ")
        s=s:gsub("%s+then%s+"," and ")
        s=s:gsub("%s+followed%s+by%s+"," and ")
        s=s:gsub("%s+also%s+"," and ")
        s=s:gsub("%s+and%s+then%s+"," and ")
        s=s:gsub("%s+"," ")
        local parts={}
        for part in (s.." and "):gmatch("(.-)%s+and%s+") do
            part=trim(part)
            if part~="" then
                for t,p in pairs(UNPROTECT) do part=part:gsub(t,p) end
                parts[#parts+1]=part
            end
        end
        if #parts==0 then parts[1]=trim(basicClean(text)) end
        return parts
    end

    local function multiplierOf(text)
        local l=text:lower()
        if l:find("twice") then return 2 end
        if l:find("thrice") then return 3 end
        local n=tonumber(l:match("(%d+)%s*times"))
        if n and n>=2 and n<=10 then return n end
        for w,v in pairs(CARDINALS) do
            if v>=2 and v<=10 and l:find("%f[%a]"..w.."%s+times") then return v end
        end
        return nil
    end

    local function stripMultiplier(text)
        local s=text
        s=s:gsub("%s*%d+%s*times%s*"," ")
        s=s:gsub("%s*twice%s*"," "):gsub("%s*thrice%s*"," ")
        for w,v in pairs(CARDINALS) do
            if v>=2 and v<=10 then s=s:gsub("%s*"..w.."%s+times%s*"," ") end
        end
        s=trim(s)
        return s~="" and s or text
    end

    local function resolvePart(part)
        local times=multiplierOf(part)
        local q=stripMultiplier(part)
        q=trim(q)
        if q=="" then return nil end
        local onlyNum=q:match("^%d+$")
        if onlyNum then return times and string.rep(onlyNum,times) or onlyNum end
        local answer=localAnswer(q)
        if not answer then return nil end
        local clean=upperClean(answer)
        if clean=="" or clean=="AND" then return nil end
        return times and string.rep(clean,times) or clean
    end

    local AI_SYSTEM = table.concat({
        "You are a riddle-answering bot for the Roblox game STEAL A BRAINROT (SAB).",
        "Reply with ONE word in ALL CAPS. No spaces. No punctuation.",
        "If the answer is a number write digits (24 not TWENTYFOUR).",
        "Owner: SAMMY (SpyderSammy, 24, Brazil, BLUE, FOOTBALL, PIZZA, RONALDO, SPIDER, SEVEN, cat NOVA).",
        "Game SAB: STEALABRAINROT, release MAY162025, first trait LIGHTNING, lightning trait MATEO.",
        "Mutations 1=BLOODROT 2=CANDY 3=LAVA 4=GALAXY 5=YINYANG 6=RADIOACTIVE 7=CURSED 8=DIVINE 9=CYBER 10=PHANTOM 11=CRYSTAL",
        "Machines 1=RAINBOWMACHINE 2=BUBBLEGUMMACHINE 3=FUSEMACHINE 4=CRAFTMACHINE 5=WITCHFUSE 6=BRAINROTDEALER 7=BRAINROTTRADER 8=SANTASFUSE 9=SANTASSHOP 10=NEWYEARSMACHINE 11=DUELSMACHINE 12=CUPIDSMACHINE 13=TRADEMACHINE 14=DIVINEFUSE 15=EGGINCUBATOR 16=CYBERCRAFTMACHINE 17=SUMMERFUSE 18=LOSTRADERS",
        "Rarest=HEADLESSHORSEMAN. Trivia: fire=DRAGON, worstowner=SECRETLOKII, boring=KEYBOARDESCAPE.",
    }, "\n")

    local function queryAI(question)
        if not httpReq then return nil end
        local body = HttpService:JSONEncode({
            model="llama-3.3-70b-versatile",
            messages={
                {role="system",content=AI_SYSTEM},
                {role="user",content="/no_think\n"..tostring(question).."\n\nONE word, ALL CAPS, no spaces."},
            },
            temperature=0, max_tokens=64,
        })
        local ok,res=pcall(httpReq,{
            Url="https://api.groq.com/openai/v1/chat/completions",
            Method="POST",
            Headers={["Content-Type"]="application/json",["Authorization"]="Bearer "..GROQ_KEY},
            Body=body,
        })
        if not ok or not res or not res.Body then return nil end
        local sc=tonumber(res.StatusCode); if sc and sc~=200 then return nil end
        local pOk,parsed=pcall(HttpService.JSONDecode,HttpService,res.Body)
        if not pOk or not parsed or not parsed.choices or not parsed.choices[1] then return nil end
        local ans=(parsed.choices[1].message and parsed.choices[1].message.content) or ""
        ans=trim(ans):upper():gsub("[%s%?%.%,!\"'`\n\r]+","")
        if ans=="" then return nil end
        if ans:find(":") then ans=ans:match(":([^:]+)$") or ans end
        return ans
    end

    solveRiddle = function(text)
        -- 1) Try the full raw text as a combined DB key first (handles multi-riddle combined keys)
        local directFull = localAnswer(text)
        if directFull then
            local df=upperClean(directFull)
            if df~="" and df~="AND" then return df end
        end

        -- 2) Split into sub-questions and resolve each part individually
        local parts=splitQuestions(text)

        -- If only one part came out (no split happened), just run it
        if #parts==1 then
            local ok,result=pcall(resolvePart,parts[1])
            if ok and result and result~="" then return result end
            -- fallback to AI only when DB has nothing
            local ai=queryAI(text)
            return ai or nil
        end

        -- Multiple parts: also try the sanitised concatenation as a combined key
        local combinedKey=table.concat(parts," ")
        local directCombined=localAnswer(combinedKey)
        if directCombined then
            local dc=upperClean(directCombined)
            if dc~="" and dc~="AND" then return dc end
        end

        -- Resolve each part independently and concatenate
        local answers={}
        local missing=0
        for _,part in ipairs(parts) do
            local ok,result=pcall(resolvePart,part)
            if ok and result and result~="" then
                answers[#answers+1]=result
            else
                missing=missing+1
            end
        end

        -- If we got at least one answer, return the concat — don't let AI override partial correct answers
        if #answers>0 then
            return table.concat(answers,"")
        end

        -- Nothing resolved at all: try AI
        local ai=queryAI(text)
        return ai or nil
    end

    local QUESTION_STARTERS={"what","whats","who","whos","when","where","which","how",
                             "name","tell","type","say","guess","answer","riddle","spell",
                             "cuantos","cuantas","quien","quienes","donde","cuando","cual",
                             "cuales","como","dime","escribe","responde"}

    looksLikeRiddle = function(text)
        local l=basicClean(text)
        if l=="" then return false end
        if not l:find(" ") then
            if SAB_DB[l] then return true end
            return false
        end
        if SAB_DB[l] then return true end
        if text:find("?",1,true) then return true end
        local first=l:match("^(%S+)")
        for _,s in ipairs(QUESTION_STARTERS) do
            if first==s then return true end
        end
        if l:find("favorite") or l:find("favourite") then return true end
        return false
    end
end
