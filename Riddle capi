--==================================================================
local function resolveRemote()
    local ok,ctrl=pcall(function()
        local c=RS:FindFirstChild("Controllers")
        local n=c and c:FindFirstChild("NotificationController",true)
        if n then return require(n) end
    end)
    if ok and type(ctrl)=="table" and type(ctrl.Start)=="function" and typeof(getupvalues)=="function" then
        local vOk,vals=pcall(getupvalues,ctrl.Start)
        if vOk and type(vals)=="table" then
            for _,v in pairs(vals) do
                if typeof(v)=="Instance" and (v:IsA("RemoteEvent") or v:IsA("UnreliableRemoteEvent")) then return v end
            end
        end
    end
    local Net = RS:FindFirstChild("Packages") and RS.Packages:FindFirstChild("Net")
    if Net and typeof(getconns)=="function" and typeof(getupvalues)=="function" then
        local getinfo = debug and (debug.getinfo or debug.info)
        if getinfo then
            for _,d in ipairs(Net:GetDescendants()) do
                if d:IsA("RemoteEvent") then
                    local ok2,cs=pcall(getconns,d.OnClientEvent)
                    if ok2 then
                        for _,cc in ipairs(cs) do
                            local f,fn=pcall(function() return cc.Function end)
                            if f and type(fn)=="function" then
                                local i,info=pcall(getinfo,fn)
                                if i and tostring(info.short_src or info.source or ""):find("NotificationController",1,true) then
                                    return d
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

local POS={Top=true,Bottom=true,Center=true,Middle=true,Left=true,Right=true,
    TopRight=true,TopLeft=true,BottomRight=true,BottomLeft=true}

local function looksAnn(...)
    local a=table.pack(...); if a.n==0 or typeof(a[1])~="string" then return false end
    for i=2,a.n do
        local v=a[i]
        if typeof(v)=="string" and (v:find("Sounds%.") or v:find("rbxassetid") or POS[v]) then return true end
    end
    return false
end

local solving=false
local lastSolveTime=0

local function safeOnAnn(...)
    if not enabled then return end
    local t=stripTags(tostring((...) or "")); if t=="" or solving then return end
    solving=true
    lastSolveTime=tick()

    task.delay(15,function()
        if solving and (tick()-lastSolveTime)>=14 then
            solving=false
        end
    end)

    task.spawn(function()
        local ok=pcall(function()
            asked=asked+1; updCnt()
            local ts=os.date("%H:%M:%S")
            addCard('<font color="rgb(140,150,170)">'..ts..'</font> <font color="rgb(255,215,0)">></font> <font color="rgb(235,240,250)">'..t:sub(1,45)..'</font>', C.gold)
            local a=solveRiddle(t)
            if a then
                a=a:upper():gsub("%s+","")
                submit(a); solved=solved+1; updCnt()
                addCard('<font color="rgb(80,220,140)">✓ '..a..'</font>', C.ok, true)
            else
                addCard('<font color="rgb(240,90,100)">✗ no match</font>', C.err, false)
            end
        end)
        solving=false
    end)
end

